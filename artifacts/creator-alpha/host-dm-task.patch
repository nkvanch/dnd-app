+const fresh = () => newCampaignPrep('c', 'Camp', 1);
+
+describe('prepEdit helpers', () => {
+  it('parses combatants; a leading ? hides one from the public projection', () => {
+    const cs = parseCombatants('Bandit, ?Doppelganger,, Captain', 'e1');
