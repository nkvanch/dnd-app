+        <Btn small label="＋ Note" onPress={() => setForm(form === 'note' ? null : 'note')} testID="prep-add-note" />
+        {form === 'note' && <NoteForm onSave={(text) => { void edit(x => addNote(x, { id: uid('note'), text })); }} />}
